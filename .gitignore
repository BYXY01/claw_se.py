# --- claw_se runtime data (created at runtime, never committed) ---
# Module data lives in same-dir same-name data/ folders (B3 convention).
src_dev/modules/**/data/
src_dev/modules/*.json.tmp
*.tmp

# --- Secrets ---
.env

# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# --- Logs ---
logs/

# --- Delivery note (working document, kept out of the repo) ---
DELIVERY*.md

# --- Build artifacts (never committed; products go to GitHub Release) ---
claw_se.py
build/
dist/
*.spec
