# ============================================================
# claw_se environment template - SECRETS ONLY (no model catalog)
# Usage: cp .env.example .env, fill in your real keys.
# The model catalog (model / base_url / key_ref / role_map)
# lives in config/providers.json, NOT here.
# ============================================================

# Main model key (OpenAI-compatible; can point at DeepSeek, etc.)
DEEPSEEK_API_KEY=sk-your-deepseek-key

# Other providers, prefixed by name (optional; enables per-provider keys)
# OPENAI_API_KEY=sk-your-openai-key

# Independent security judge key (optional; falls back to DEEPSEEK_API_KEY
# by referencing the same key in providers.json)
# SECURITY_KEY=sk-your-security-key
